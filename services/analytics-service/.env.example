# Analytics database connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/pulsar_analytics

# Port the analytics service listens on (optional, default 3100)
PORT=3100

# Cache TTL for analytics query results, in seconds.
# Set to 0 (or leave unset) to disable caching and always return fresh data.
# Recommended: 60 for near-real-time dashboards, 300 for heavier reports.
ANALYTICS_CACHE_TTL_SECONDS=60

# Maximum number of clients in the PostgreSQL connection pool (optional, default 10).
# Increase for higher concurrency, but keep within your database's connection limit.
ANALYTICS_DB_POOL_MAX=10

# How long (in milliseconds) an idle client may remain in the pool before being
# closed and removed (optional, default 30000).
ANALYTICS_DB_IDLE_TIMEOUT_MS=30000

# How long (in milliseconds) to wait when acquiring a client from the pool before
# failing with a timeout error (optional, default 5000).
ANALYTICS_DB_CONNECTION_TIMEOUT_MS=5000